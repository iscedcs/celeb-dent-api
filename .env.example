# Copy this file to .env and fill in real values. Never commit .env.

# --- Server ---
PORT=3000
# Comma-separated list of frontend origins allowed to call this API (CORS).
# Leave empty in production until you have a real frontend URL — no origins are allowed by default.
CORS_ORIGINS=http://localhost:3001
FRONTEND_URL=http://localhost:3001

# --- Database (Prisma / Postgres) ---
# Include connection_limit and pool_timeout to avoid the connection-pool exhaustion
# incident documented in EMERGENCY_DATABASE_FIX.md
DATABASE_URL=postgresql://user:password@host:5432/dbname?connection_limit=10&pool_timeout=20

# --- Auth / JWT ---
# Generate strong random secrets, e.g.: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES=7d
JWT_RESET_SECRET=

# --- Field-level encryption (src/utils/crypto.util.ts) ---
# 32-byte key as hex, e.g.: openssl rand -hex 32
ENCRYPTION_KEY=

# --- Seed / initial superadmin account (prisma/seed.ts) ---
# Set these to a real email/strong password before running the seed script.
# NOTE: prisma/seed.ts currently still falls back to a hardcoded default if these
# are unset — that fix wasn't in this round's list, flag if you want it done too.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# --- Outgoing email (src/utils/mail.service.ts) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_REJECT_UNAUTHORIZED=true
EMAIL_FROM=
